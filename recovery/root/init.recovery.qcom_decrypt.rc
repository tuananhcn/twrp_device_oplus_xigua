# Script kích hoạt giải mã bộ nhớ Data mã hóa FBE cho chip Qualcomm
# Sử dụng KeyMint AIDL + Gatekeeper AIDL (thay thế Keymaster 4.1 + Gatekeeper 1.0 cũ)

service vendor.gatekeeper-qti /vendor/bin/hw/android.hardware.gatekeeper-service-qti
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0

service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0

on property:prepdecrypt.setpatch=true
    start vendor.keymint-qti
    start vendor.gatekeeper-qti
